# Database: SQLite by default for instant local setup; or PostgreSQL if installed.
DATABASE_URL=sqlite:///./bountydesk.db
# DATABASE_URL=postgresql+psycopg://bountydesk:CHANGE_ME@localhost:5432/bountydesk

# Authentication secrets (APP_SECRET: 32+ chars; passwords: 16+ chars)
APP_SECRET=bountydesk-dev-secret-key-shopnest-32chars-min
RESEARCHER_PASSWORD=researcher-demo-pass-1234
LEAD_PASSWORD=lead-demo-pass-1234

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false
APP_ENV=development
